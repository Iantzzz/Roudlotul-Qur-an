{
    "version": 2,
    "builds": [
        { "src": "/api/index.php", "use": "vercel-php@0.7.4" },
        { "src": "/public/**", "use": "@vercel/static" }
    ],
    "routes": [
        { "src": "/(css|js|images)/(.*)", "dest": "/public/$1/$2" },
        { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
        { "src": "/favicon-32x32.png", "dest": "/public/favicon-32x32.png" },
        { "src": "/apple-touch-icon.png", "dest": "/public/apple-touch-icon.png" },
        { "src": "/robots.txt", "dest": "/public/robots.txt" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_NAME": "Roudlotul Qur'an",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "array",
        "CACHE_STORE": "array",
        "VIEW_COMPILED_PATH": "/tmp/views",
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php"
    }
}
